component SettingsPage inherits Rectangle {
    background: Palette.bg;
    property <int> refocus: AppState.focus-page;
    changed refocus => {
        // never pull focus out of a dialog that opened in the meantime
        if (!AppState.overlay-open) {
            page-focus.focus();
        }
    }
    page-focus := FocusScope {
        init => {
            self.focus();
        }
        fl := Flickable {
            content-height: inner.preferred-height + 12px;
            inner := HorizontalLayout {
                y: 10px;
                width: fl.width;
                height: self.preferred-height;
                spacing: Palette.gap * 1.75;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: Palette.gap * 1.75;
                    Panel {
                        title: "appearance";
                        SettingRow {
                            label: "theme";
                            Text {
                                text: AppState.theme-name;
                                color: Palette.fg;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            TBtn {
                                label: "choose…";
                                clicked => {
                                    AppState.open-themes();
                                }
                            }
                        }
                        SettingRow {
                            label: "animations";
                            TBtn {
                                label: AppState.anim-on ? "on" : "off";
                                on: AppState.anim-on;
                                clicked => {
                                    AppState.toggle-anim();
                                }
                            }
                            Text {
                                text: "only on save/open, never while idle";
                                color: Palette.dim;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    Panel {
                        title: "text";
                        SettingRow {
                            label: "font";
                            Text {
                                text: AppState.font-name;
                                color: Palette.fg;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            TBtn {
                                label: "change";
                                clicked => {
                                    AppState.open-fonts();
                                }
                            }
                        }
                        SettingRow {
                            label: "size";
                            TBtn {
                                label: "–";
                                clicked => {
                                    AppState.bump-font-size(-1);
                                }
                            }
                            Text {
                                text: AppState.font-size-px + " px";
                                color: Palette.fg;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                min-width: Palette.ch * 6;
                            }
                            TBtn {
                                label: "+";
                                clicked => {
                                    AppState.bump-font-size(1);
                                }
                            }
                            TBtn {
                                label: "reset";
                                clicked => {
                                    AppState.reset-font-size();
                                }
                            }
                            Rectangle { }
                        }
                        SettingRow {
                            label: "spacing";
                            TBtn {
                                label: "compact";
                                on: AppState.density-mode == "compact";
                                clicked => {
                                    AppState.set-density("compact");
                                }
                            }
                            TBtn {
                                label: "normal";
                                on: AppState.density-mode == "normal";
                                clicked => {
                                    AppState.set-density("normal");
                                }
                            }
                            TBtn {
                                label: "roomy";
                                on: AppState.density-mode == "roomy";
                                clicked => {
                                    AppState.set-density("roomy");
                                }
                            }
                            Rectangle { }
                        }
                        Text {
                            text: "shortcuts for size are on the keys tab";
                            color: Palette.dim;
                            wrap: word-wrap;
                        }
                    }
                    Panel {
                        title: "privacy";
                        SettingRow {
                            label: "clipboard";
                            TBtn {
                                label: "off";
                                on: AppState.clip-secs == 0;
                                clicked => {
                                    AppState.set-clip-secs(0);
                                }
                            }
                            TBtn {
                                label: "15 s";
                                on: AppState.clip-secs == 15;
                                clicked => {
                                    AppState.set-clip-secs(15);
                                }
                            }
                            TBtn {
                                label: "30 s";
                                on: AppState.clip-secs == 30;
                                clicked => {
                                    AppState.set-clip-secs(30);
                                }
                            }
                            TBtn {
                                label: "60 s";
                                on: AppState.clip-secs == 60;
                                clicked => {
                                    AppState.set-clip-secs(60);
                                }
                            }
                            Rectangle { }
                        }
                        Text {
                            text: "A copied secret field (or a template that contains one) is removed from the clipboard after this long, unless you copied something else meanwhile.";
                            color: Palette.dim;
                            wrap: word-wrap;
                        }
                    }
                    Panel {
                        title: "window";
                        SettingRow {
                            label: "title bar";
                            TBtn {
                                label: "auto";
                                on: AppState.window-bar-mode == "auto";
                                clicked => {
                                    AppState.set-window-bar("auto");
                                }
                            }
                            TBtn {
                                label: "built-in";
                                on: AppState.window-bar-mode == "builtin";
                                clicked => {
                                    AppState.set-window-bar("builtin");
                                }
                            }
                            TBtn {
                                label: "native";
                                on: AppState.window-bar-mode == "native";
                                clicked => {
                                    AppState.set-window-bar("native");
                                }
                            }
                            Rectangle { }
                        }
                        Text {
                            text: "built-in draws paddy's own bar (drag, minimize, maximize, close). auto uses it on WSL, where the native one is unreliable.";
                            color: Palette.dim;
                            wrap: word-wrap;
                        }
                    }
                    Panel {
                        title: "quick list";
                        SettingRow {
                            label: "hotkey";
                            TInput {
                                text <=> AppState.settings-hotkey;
                                placeholder: "ctrl+alt+p";
                                accepted => {
                                    AppState.apply-hotkey();
                                }
                            }
                            TBtn {
                                label: "apply";
                                clicked => {
                                    AppState.apply-hotkey();
                                }
                            }
                        }
                        SettingRow {
                            label: "floating button";
                            TBtn {
                                label: AppState.mini-on ? "shown" : "hidden";
                                on: AppState.mini-on;
                                clicked => {
                                    AppState.toggle-mini();
                                }
                            }
                            Text {
                                text: "opens the quick list; handy with no tray";
                                color: Palette.dim;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        Text {
                            text: AppState.settings-note;
                            color: Palette.accent;
                            wrap: word-wrap;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: Palette.gap * 1.75;
                    Panel {
                        title: "about";
                        HorizontalLayout {
                            spacing: Palette.gap * 2.25;
                            Logo {
                                data: AppState.logo;
                                cols: 24;
                                rows: 22;
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: Palette.gap * 0.5;
                                Text {
                                    text: "paddy";
                                    color: Palette.accent;
                                    font-weight: 700;
                                }
                                Text {
                                    text: AppState.about-text;
                                    color: Palette.dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    Panel {
                        title: "files";
                        Text {
                            text: "settings file";
                            color: Palette.dim;
                        }
                        HorizontalLayout {
                            spacing: Palette.gap;
                            Text {
                                text: AppState.config-path;
                                color: Palette.fg;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            TBtn {
                                label: "copy";
                                clicked => {
                                    AppState.copy-path(AppState.config-path);
                                }
                            }
                        }
                        Text {
                            text: "vaults folder";
                            color: Palette.dim;
                        }
                        HorizontalLayout {
                            spacing: Palette.gap;
                            Text {
                                text: AppState.vaults-path;
                                color: Palette.fg;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            TBtn {
                                label: "copy";
                                clicked => {
                                    AppState.copy-path(AppState.vaults-path);
                                }
                            }
                        }
                    }
                    Panel {
                        title: "resources (this app)";
                        Text {
                            text: AppState.diag-text;
                            color: Palette.fg;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "refreshes every 2s while this tab is open";
                            color: Palette.dim;
                        }
                    }
                }
            }
        }
    }
}

component HelpOverlay inherits Overlay {
    FocusScope {
        // Overlays sit outside the main key scope, so they carry the shared shortcuts too
        // (Rust decides which actions may run while a dialog is open).
        for b in AppState.bindings: KeyBinding {
            keys: b.keys;
            activated => {
                AppState.run-action(b.action);
            }
        }
        init => {
            self.focus();
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                AppState.close-help();
            }
        }
        Panel {
            title: "keyboard shortcuts";
            active: true;
            width: min(parent.width - 60px, 900px);
            height: min(parent.height - 40px, 580px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            HorizontalLayout {
                spacing: Palette.gap * 3.75;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    for r in AppState.help-left: HorizontalLayout {
                        height: Palette.row;
                        if r.header: Text {
                            text: r.what;
                            color: Palette.dim;
                            vertical-alignment: bottom;
                        }
                        if !r.header: ShortcutRow {
                            keys: r.keys;
                            what: r.what;
                        }
                    }
                    Rectangle { }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    for r in AppState.help-right: HorizontalLayout {
                        height: Palette.row;
                        if r.header: Text {
                            text: r.what;
                            color: Palette.dim;
                            vertical-alignment: bottom;
                        }
                        if !r.header: ShortcutRow {
                            keys: r.keys;
                            what: r.what;
                        }
                    }
                    Rectangle { }
                }
            }
        }
    }
}

component KeysPage inherits Rectangle {
    background: Palette.bg;
    property <int> refocus: AppState.focus-page;
    changed refocus => {
        // never pull focus out of a dialog that opened in the meantime
        if (!AppState.overlay-open) {
            page-focus.focus();
        }
    }
    page-focus := FocusScope {
        init => {
            self.focus();
        }
        // While recording, the next chord is captured (before any shortcut can fire).
        capture-key-pressed(e) => {
            if (AppState.recording != "") {
                AppState.record-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                return accept;
            }
            reject
        }
        Panel {
            title: "keyboard shortcuts";
            active: AppState.recording != "";
            VerticalLayout {
                spacing: Palette.gap * 0.75;
                Text {
                    text: AppState.recording != "" ? "press the new shortcut for “" + AppState.recording-label + "”   ·   Esc cancels" : "click [change] to record a new shortcut, [add] for a second one. Esc, Enter and the arrow keys are fixed.";
                    color: AppState.recording != "" ? Palette.accent : Palette.dim;
                    wrap: word-wrap;
                }
                Text {
                    text: AppState.keys-note;
                    color: Palette.warn;
                    wrap: word-wrap;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: krows.preferred-height + 4px;
                    krows := VerticalLayout {
                        y: 0;
                        width: parent.width;
                        height: self.preferred-height;
                        spacing: 2px;
                        for r in AppState.key-rows: HorizontalLayout {
                            height: Palette.row;
                            spacing: Palette.gap;
                            if r.header: Text {
                                text: r.label;
                                color: Palette.dim;
                                vertical-alignment: bottom;
                            }
                            if !r.header: Text {
                                text: r.label;
                                color: AppState.recording == r.id ? Palette.accent : Palette.fg;
                                width: Palette.ch * 26;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if !r.header: Text {
                                text: r.chords;
                                color: r.is-default ? Palette.dim : Palette.accent;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if !r.header: TBtn {
                                label: "change";
                                on: AppState.recording == r.id;
                                clicked => {
                                    AppState.key-change(r.id);
                                }
                            }
                            if !r.header: TBtn {
                                label: "add";
                                clicked => {
                                    AppState.key-add(r.id);
                                }
                            }
                            if !r.header: TBtn {
                                label: "clear";
                                clicked => {
                                    AppState.key-clear(r.id);
                                }
                            }
                            if !r.header: TBtn {
                                label: "reset";
                                tint: r.is-default ? Palette.line : Palette.dim;
                                clicked => {
                                    AppState.key-reset(r.id);
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Palette.gap;
                    TBtn {
                        label: "reset all to defaults";
                        clicked => {
                            AppState.keys-reset-all();
                        }
                    }
                    Text {
                        text: "or edit the settings file:  key.save = ctrl+s";
                        color: Palette.dim;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

component ThemesOverlay inherits Picker {
    title: "theme";
    placeholder: "filter themes…";
    hint: "↑↓ preview live   Enter keep   Esc cancel";
    query <=> AppState.tp-query;
    rows: AppState.tp-rows;
    selected: AppState.tp-selected;
    edited => {
        AppState.tp-edited();
    }
    select(i) => {
        AppState.tp-select(i);
    }
    chosen => {
        AppState.tp-open();
    }
    close => {
        AppState.close-themes();
    }
}

// "Do you want to import this?" dialog for things fetched from a URL.
component ImportOverlay inherits Overlay {
    FocusScope {
        init => {
            self.focus();
        }
        for b in AppState.bindings: KeyBinding {
            keys: b.keys;
            activated => {
                AppState.run-action(b.action);
            }
        }
        KeyBinding {
            keys: @keys(Return);
            activated => {
                AppState.import-yes();
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                AppState.import-no();
            }
        }
        Panel {
            title: AppState.import-title;
            active: true;
            width: min(parent.width - 60px, 720px);
            height: min(parent.height - 60px, 360px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            VerticalLayout {
                spacing: Palette.gap * 1.5;
                Text {
                    text: AppState.import-body;
                    color: Palette.fg;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                Text {
                    text: "Nothing is saved until you press Enter. It is plain data and is never run.";
                    color: Palette.dim;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: Palette.gap * 2;
                    TBtn {
                        label: "import (Enter)";
                        clicked => {
                            AppState.import-yes();
                        }
                    }
                    TBtn {
                        label: "cancel (Esc)";
                        clicked => {
                            AppState.import-no();
                        }
                    }
                    Rectangle { }
                }
            }
        }
    }
}

component PacksPage inherits Rectangle {
    background: Palette.bg;
    property <int> refocus: AppState.focus-page;
    changed refocus => {
        // never pull focus out of a dialog that opened in the meantime
        if (!AppState.overlay-open) {
            page-focus.focus();
        }
    }
    page-focus := FocusScope {
        init => {
            self.focus();
        }
        fl := Flickable {
            content-height: inner.preferred-height + 12px;
            inner := VerticalLayout {
                y: 10px;
                width: fl.width;
                height: self.preferred-height;
                spacing: Palette.gap * 1.75;
                Panel {
                    title: "themes";
                    SettingRow {
                        label: "current";
                        Text {
                            text: AppState.theme-name;
                            color: Palette.fg;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        TBtn {
                            label: "choose…";
                            clicked => {
                                AppState.open-themes();
                            }
                        }
                    }
                    Text {
                        text: "12 themes are built in and work offline. Themes are plain color files: put your own in the themes folder, or import one from a URL below.";
                        color: Palette.dim;
                        wrap: word-wrap;
                    }
                }
                Panel {
                    title: "import from a URL";
                    SettingRow {
                        label: "https://";
                        TInput {
                            text <=> AppState.import-url;
                            placeholder: "link to a .theme or template pack file";
                            accepted => {
                                AppState.import-templates-url();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Palette.gap;
                        TBtn {
                            label: "fetch as theme";
                            clicked => {
                                AppState.import-theme-url();
                            }
                        }
                        TBtn {
                            label: "fetch as template pack";
                            clicked => {
                                AppState.import-templates-url();
                            }
                        }
                        Text {
                            text: AppState.net-busy ? "  downloading…" : "";
                            color: Palette.accent;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                    }
                    Text {
                        text: "https only · size-limited · public servers only · you see what it is and confirm before anything is saved.";
                        color: Palette.dim;
                        wrap: word-wrap;
                    }
                    Text {
                        text: AppState.net-note;
                        color: Palette.accent;
                        wrap: word-wrap;
                    }
                }
                Panel {
                    title: "fonts";
                    for f in AppState.pk-fonts: HorizontalLayout {
                        height: Palette.row;
                        spacing: Palette.gap;
                        Text {
                            text: (f.active ? "▸ " : "  ") + f.family;
                            color: f.active ? Palette.accent : Palette.fg;
                            width: Palette.ch * 22;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: f.license + "  ·  " + f.size;
                            color: Palette.dim;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        TBtn {
                            label: f.installed ? "use" : "download";
                            on: f.active;
                            clicked => {
                                if (f.installed) {
                                    AppState.font-use(f.id);
                                } else {
                                    AppState.font-install(f.id);
                                }
                            }
                        }
                    }
                    Text {
                        text: "Downloaded from each font's official project and checked against a built-in checksum, so a tampered file is rejected. Use the font picker in Settings for fonts already on your system.";
                        color: Palette.dim;
                        wrap: word-wrap;
                    }
                }
                Panel {
                    title: "template packs";
                    for p in AppState.pk-packs: HorizontalLayout {
                        height: Palette.row;
                        spacing: Palette.gap;
                        Text {
                            text: p.name + "  (" + p.count + ")";
                            color: Palette.fg;
                            width: Palette.ch * 34;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: p.detail;
                            color: Palette.dim;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        TBtn {
                            label: "add to this vault";
                            clicked => {
                                AppState.pack-add(p.id);
                            }
                        }
                    }
                    Text {
                        text: "Built in, so they work offline. Already-present templates are skipped, so adding twice is harmless. Open them with Ctrl+T.";
                        color: Palette.dim;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component FontsOverlay inherits Picker {
    title: "font";
    placeholder: "filter fonts…";
    hint: "↑↓ preview live   Enter keep   Esc cancel";
    query <=> AppState.fp-query;
    rows: AppState.fp-rows;
    selected: AppState.fp-selected;
    edited => {
        AppState.fp-edited();
    }
    select(i) => {
        AppState.fp-select(i);
    }
    chosen => {
        AppState.fp-open();
    }
    close => {
        AppState.close-fonts();
    }
}

export component MainWindow inherits Window {
    title: "paddy";
    // Embedded at build time: Slint only hands images with a cache key to the window manager.
    icon: @image-url("../../assets/icons/paddy-256.png");
    preferred-width: 1000px;
    preferred-height: 640px;
    // Fixed: changing the font size must never resize the window.
    min-width: 780px;
    min-height: 460px;
    background: Palette.bg;
    default-font-family: Palette.font;
    default-font-size: Palette.fs;
    no-frame: AppState.builtin-bar;

    // Built-in title bar plumbing (Rust moves/resizes the real window).
    callback drag-window(length, length);
    callback resize-window(length, length);
    // Ask the window manager to run the move / resize (works on X11 and Wayland).
    // Returns false where that isn't available; the manual fallback above is used then.
    callback start-drag() -> bool;
    callback start-resize() -> bool;
    property <bool> native-move;
    callback minimize-window();
    callback toggle-maximize();
    callback close-window();

    public function focus-label() {
        editor.focus-label();
    }
    public function focus-list() {
        list.focus-list();
    }
    public function focus-fields() {
        editor.focus-fields();
    }
    public pure function fields-focused() -> bool {
        return editor.fields-focused();
    }
    public function focus-search() {
        list.focus-search();
    }

    property <int> selected: AppState.selected;
    changed selected => {
        list.ensure-visible(self.selected);
    }

    root-scope := FocusScope {
        init => {
            list.focus-list();
        }
        // Bound chords run before the focused widget sees them, so Alt+↑/↓ and friends
        // work while typing in a field. Rust looks the chord up in the keymap.
        // (Not while the keys tab records a new shortcut: that page captures it.)
        capture-key-pressed(e) => {
            if (AppState.recording == "" && AppState.key-capture(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)) {
                return accept;
            }
            reject
        }
        // Every remappable shortcut: built from the keymap (settings file / keys tab).
        for b in AppState.bindings: KeyBinding {
            keys: b.keys;
            activated => {
                AppState.run-action(b.action);
            }
        }
        // Structural key, not remappable.
        KeyBinding {
            keys: @keys(Escape);
            enabled: !AppState.overlay-open;
            activated => {
                if (AppState.tab != 0) {
                    AppState.close-settings();
                }
                list.focus-list();
            }
        }

        VerticalLayout {
            padding: Palette.gap * 1.5;
            padding-top: AppState.builtin-bar ? 0px : 12px;
            spacing: Palette.gap * 1.5;

            // Header: title, tabs, status, and (built-in bar) window buttons.
            Rectangle {
                height: max(34px, Palette.row + 12px);
                vertical-stretch: 0;
                // Empty header space drags the window when the built-in bar is on.
                TouchArea {
                    enabled: AppState.builtin-bar;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.native-move = false;
                        }
                    }
                    moved => {
                        // Hand the drag to the window manager on the first movement (so a
                        // plain double-click still maximizes); fall back to moving ourselves.
                        if (!root.native-move) {
                            root.native-move = root.start-drag();
                        }
                        if (!root.native-move) {
                            root.drag-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                    double-clicked => {
                        root.toggle-maximize();
                    }
                }
                HorizontalLayout {
                    spacing: Palette.gap * 1.25;
                    VerticalLayout {
                        alignment: center;
                        Logo {
                            data: AppState.logo-mini;
                            cols: 8;
                            rows: 4;
                            unit: 7px;
                        }
                    }
                    Text {
                        text: "paddy";
                        color: Palette.accent;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "▸ " + AppState.vault-name;
                        color: Palette.fg;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 8px;
                    }
                    VerticalLayout {
                        alignment: center;
                        TabBtn {
                            height: Palette.row + 4px;
                            label: "entries";
                            active: AppState.tab == 0;
                            clicked => {
                                AppState.close-settings();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TabBtn {
                            height: Palette.row + 4px;
                            label: "keys";
                            active: AppState.tab == 2;
                            clicked => {
                                AppState.open-keys();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TabBtn {
                            height: Palette.row + 4px;
                            label: "packs";
                            active: AppState.tab == 3;
                            clicked => {
                                AppState.open-packs();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TabBtn {
                            height: Palette.row + 4px;
                            label: "settings";
                            active: AppState.tab == 1;
                            clicked => {
                                AppState.open-settings();
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: AppState.status;
                        color: AppState.status-error ? Palette.warn : Palette.accent;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: AppState.dirty ? "● unsaved" : "○ saved";
                        color: AppState.dirty ? Palette.warn : Palette.dim;
                        vertical-alignment: center;
                    }
                    if AppState.builtin-bar: HorizontalLayout {
                        spacing: 2px;
                        WinBtn {
                            glyph: "–";
                            clicked => {
                                root.minimize-window();
                            }
                        }
                        WinBtn {
                            glyph: "□";
                            clicked => {
                                root.toggle-maximize();
                            }
                        }
                        WinBtn {
                            glyph: "×";
                            hover: Palette.warn.with-alpha(0.35);
                            clicked => {
                                root.close-window();
                            }
                        }
                    }
                }
            }

            // Body: entries view, with the settings page stacked on top when that tab is open.
            Rectangle {
                vertical-stretch: 1;
                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    visible: AppState.tab == 0;
                    spacing: Palette.gap * 1.75;
                    list := EntryList {
                        width: 300px;
                        edit => {
                            if (AppState.selected >= 0) {
                                editor.focus-label();
                            }
                        }
                    }
                    editor := EntryEditor {
                        horizontal-stretch: 1;
                    }
                }
                if AppState.tab == 1: SettingsPage {
                    width: parent.width;
                    height: parent.height;
                }
                if AppState.tab == 2: KeysPage {
                    width: parent.width;
                    height: parent.height;
                }
                if AppState.tab == 3: PacksPage {
                    width: parent.width;
                    height: parent.height;
                }
            }

            // Footer: the essentials (from the keymap); the help screen lists everything.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Palette.gap * 2.75;
                for h in AppState.hints: KeyHint {
                    key: h.key;
                    label: h.label;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if AppState.help-key != "": KeyHint {
                    key: AppState.help-key;
                    label: "all shortcuts";
                }
                // leave room for the resize grip
                Rectangle {
                    width: AppState.builtin-bar ? 14px : 0px;
                }
            }
        }
    }

    if AppState.confirm-delete: ConfirmDelete {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-templates: TemplatesOverlay {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-vaults: VaultsOverlay {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-global: GlobalOverlay {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-themes: ThemesOverlay {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-import: ImportOverlay {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-fonts: FontsOverlay {
        width: parent.width;
        height: parent.height;
    }
    if AppState.show-help: HelpOverlay {
        width: parent.width;
        height: parent.height;
    }

    // Window border and resize grip for the built-in bar.
    if AppState.builtin-bar: Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: Palette.line;
    }
    if AppState.builtin-bar: Rectangle {
        x: parent.width - 18px;
        y: parent.height - 18px;
        width: 18px;
        height: 18px;
        Text {
            text: "◢";
            color: Palette.dim;
            horizontal-alignment: right;
            vertical-alignment: bottom;
        }
        TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.native-move = false;
                }
            }
            moved => {
                if (!root.native-move) {
                    root.native-move = root.start-resize();
                }
                if (!root.native-move) {
                    root.resize-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
    }
}
