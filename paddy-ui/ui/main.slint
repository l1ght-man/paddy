import { Palette } from "theme.slint";
import { AppState, Binding, EntryRow, FieldRow, FontRow, HelpRow, Hint, KeyRow, MdBlock, PackRow, PickRow, TemplateRow, VarRow } from "state.slint";
import { Panel, TInput, NotesInput, TBtn, KeyHint, TabBtn, WinBtn, SettingRow, ShortcutRow, Logo } from "widgets.slint";
import { QuickRow, PopupState, QuickWindow, MiniWindow } from "popup.slint";

export { AppState, Binding, EntryRow, FieldRow, FontRow, PackRow, HelpRow, Hint, KeyRow, MdBlock, PickRow, Palette, TemplateRow, VarRow, QuickRow, PopupState, QuickWindow, MiniWindow }

component EntryList inherits Panel {
    title: "entries";
    active: fs.has-focus;
    public function focus-list() {
        fs.focus();
    }
    public function ensure-visible(i: int) {
        if (i >= 0) {
            if (i * Palette.row < -lf.content-y) {
                lf.content-y = -i * Palette.row;
            } else if ((i + 1) * Palette.row > -lf.content-y + lf.height) {
                lf.content-y = -((i + 1) * Palette.row - lf.height);
            }
        }
    }
    callback edit();
    public function focus-search() {
        search-in.focus-input();
    }

    VerticalLayout {
        spacing: Palette.gap * 0.75;
        FocusScope {
            height: Palette.row;
            KeyBinding {
                keys: @keys(Escape);
                activated => {
                    AppState.search = "";
                    AppState.search-edited();
                    fs.focus();
                }
            }
            HorizontalLayout {
                spacing: Palette.gap * 0.75;
                Text {
                    text: "/";
                    color: Palette.dim;
                    vertical-alignment: center;
                }
                search-in := TInput {
                    placeholder: "search this vault (Ctrl+F)";
                    text <=> AppState.search;
                    edited => {
                        AppState.search-edited();
                    }
                    accepted => {
                        fs.focus();
                    }
                }
            }
        }

    fs := FocusScope {
        KeyBinding {
            keys: @keys(UpArrow);
            activated => {
                if (AppState.selected > 0) {
                    AppState.select(AppState.selected - 1);
                }
            }
        }
        KeyBinding {
            keys: @keys(DownArrow);
            activated => {
                if (AppState.selected < AppState.entries.length - 1) {
                    AppState.select(AppState.selected + 1);
                }
            }
        }
        KeyBinding {
            keys: @keys(Home);
            activated => {
                if (AppState.entries.length > 0) {
                    AppState.select(0);
                }
            }
        }
        KeyBinding {
            keys: @keys(End);
            activated => {
                if (AppState.entries.length > 0) {
                    AppState.select(AppState.entries.length - 1);
                }
            }
        }
        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.edit();
            }
        }
        KeyBinding {
            keys: @keys("/");
            activated => {
                root.focus-search();
            }
        }

        lf := Flickable {
            content-height: AppState.entries.length * Palette.row;
            for e[i] in AppState.entries: Rectangle {
                y: i * Palette.row;
                height: Palette.row;
                width: parent.width;
                background: i == AppState.selected ? Palette.sel-bg : transparent;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: Palette.gap;
                    Text {
                        text: i == AppState.selected ? "▸" : " ";
                        color: Palette.accent;
                        vertical-alignment: center;
                    }
                    Text {
                        text: e.label == "" ? "(untitled)" : e.label;
                        color: e.label == "" ? Palette.dim : Palette.fg;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: e.tags;
                        color: Palette.dim;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: Palette.ch * 12;
                    }
                }
                TouchArea {
                    clicked => {
                        AppState.select(i);
                        fs.focus();
                    }
                }
            }
        }
    }
    }
}

component FieldRowView inherits Rectangle {
    in property <int> index;
    in property <FieldRow> f;
    // Keyboard cursor of the fields area is on this row (Enter copies it).
    in property <bool> cursor;
    height: Palette.row;
    background: root.cursor ? Palette.sel-bg : transparent;
    border-width: 1px;
    border-color: root.cursor ? Palette.accent : transparent;

    HorizontalLayout {
        spacing: Palette.gap * 0.75;
        Text {
            text: root.cursor ? "▸" : " ";
            color: Palette.accent;
            width: Palette.ch * 1.5;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        key-in := TInput {
            width: Palette.ch * 17;
            placeholder: "key";
            text: root.f.key;
            edited => {
                AppState.field-edited(root.index, self.text, val.text);
            }
            init => {
                if (AppState.focus-field == root.index) {
                    AppState.focus-field = -1;
                    self.focus-input();
                }
            }
        }
        Text {
            text: "=";
            color: Palette.dim;
            vertical-alignment: center;
        }
        val := TInput {
            horizontal-stretch: 1;
            placeholder: "value";
            text: root.f.value;
            password: root.f.secret && root.f.hidden;
            edited => {
                AppState.field-edited(root.index, key-in.text, self.text);
            }
        }
        TBtn {
            label: "s";
            on: root.f.secret;
            clicked => {
                AppState.field-toggle-secret(root.index);
            }
        }
        TBtn {
            label: "h";
            on: root.f.hidden;
            visible: root.f.secret;
            clicked => {
                AppState.field-toggle-hidden(root.index);
            }
        }
        TBtn {
            label: "c";
            on: root.cursor;
            clicked => {
                AppState.field-copy(root.index);
            }
        }
        TBtn {
            label: "x";
            tint: Palette.warn;
            clicked => {
                AppState.field-remove(root.index);
            }
        }
    }
}

component MdBlockView inherits HorizontalLayout {
    in property <MdBlock> b;
    padding-left: b.kind == "li" ? b.level * Palette.ch * 2 : 0px;
    spacing: Palette.ch;
    if b.kind == "h": Text {
        text: b.plain;
        color: Palette.accent;
        font-weight: 700;
        font-size: b.level == 1 ? Palette.fs * 1.5 : (b.level == 2 ? Palette.fs * 1.25 : Palette.fs * 1.1);
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
    if b.kind == "p": StyledText {
        text: b.text;
        default-color: Palette.fg;
        default-font-size: Palette.fs;
        link-color: Palette.accent;
        horizontal-stretch: 1;
        link-clicked(l) => {
            AppState.md-link(l);
        }
    }
    if b.kind == "li": Text {
        text: b.marker;
        color: Palette.accent;
        vertical-alignment: top;
        min-width: Palette.ch * 3;
    }
    if b.kind == "li": StyledText {
        text: b.text;
        default-color: Palette.fg;
        default-font-size: Palette.fs;
        link-color: Palette.accent;
        horizontal-stretch: 1;
        link-clicked(l) => {
            AppState.md-link(l);
        }
    }
    if b.kind == "quote": Rectangle {
        width: 3px;
        background: Palette.accent;
    }
    if b.kind == "quote": StyledText {
        text: b.text;
        default-color: Palette.dim;
        default-font-size: Palette.fs;
        link-color: Palette.accent;
        horizontal-stretch: 1;
    }
    if b.kind == "code": Rectangle {
        background: Palette.sel-bg;
        horizontal-stretch: 1;
        min-height: code-text.preferred-height + 8px;
        code-text := Text {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            text: b.plain;
            color: Palette.fg;
            wrap: word-wrap;
        }
    }
    if b.kind == "rule": Rectangle {
        height: Palette.row * 0.5;
        horizontal-stretch: 1;
        Rectangle {
            y: parent.height / 2;
            height: 1px;
            background: Palette.line;
        }
    }
    if b.kind == "gap": Rectangle {
        height: Palette.fs * 0.5;
    }
}

component MdView inherits Rectangle {
    background: Palette.panel;
    border-width: 1px;
    border-color: Palette.line;
    fl := Flickable {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        content-height: col.preferred-height + 4px;
        col := VerticalLayout {
            y: 0;
            width: fl.width;
            height: self.preferred-height;
            spacing: 3px;
            for b in AppState.md-blocks: MdBlockView {
                b: b;
            }
        }
    }
    if AppState.md-blocks.length == 0: Text {
        text: "nothing to preview yet — write some markdown in the editor";
        color: Palette.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component EntryEditor inherits Panel {
    title: "entry";
    active: label-in.has-focus || tags-in.has-focus || notes-in.has-focus || fields-fs.has-focus;
    public function focus-label() {
        label-in.focus-input();
    }
    // The fields area: a cursor row instead of a text cursor (keyboard walk + copy).
    public function focus-fields() {
        fields-fs.focus();
    }
    public pure function fields-focused() -> bool {
        return fields-fs.has-focus;
    }
    function step-field(d: int) {
        AppState.field-cursor = max(0, min(AppState.draft-fields.length - 1, AppState.field-cursor + d));
    }
    // Keep the cursor row on screen.
    property <int> cursor: AppState.field-cursor;
    property <length> field-stride: Palette.row + 4px;
    changed cursor => {
        if (root.cursor >= 0) {
            if (root.cursor * root.field-stride < -ff.content-y) {
                ff.content-y = -root.cursor * root.field-stride;
            } else if ((root.cursor + 1) * root.field-stride > -ff.content-y + ff.height) {
                ff.content-y = -((root.cursor + 1) * root.field-stride - ff.height);
            }
        }
    }

    Rectangle {
        VerticalLayout {
            visible: AppState.selected < 0;
            alignment: center;
            spacing: Palette.gap * 1.75;
            HorizontalLayout {
                alignment: center;
                Logo {
                    data: AppState.logo;
                    cols: 24;
                    rows: 22;
                    tint: Palette.line;
                }
            }
            Text {
                text: "no entry selected — press Ctrl+N to add one";
                color: Palette.dim;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
        visible: AppState.selected >= 0;
        width: parent.width;
        height: parent.height;
        spacing: Palette.gap;
        HorizontalLayout {
            spacing: Palette.gap;
            Text {
                text: "label";
                color: Palette.dim;
                width: Palette.ch * 7;
                vertical-alignment: center;
            }
            label-in := TInput {
                text <=> AppState.draft-label;
                placeholder: "name of this entry";
                edited => {
                    AppState.draft-edited();
                }
            }
        }
        HorizontalLayout {
            spacing: Palette.gap;
            Text {
                text: "tags";
                color: Palette.dim;
                width: Palette.ch * 7;
                vertical-alignment: center;
            }
            tags-in := TInput {
                text <=> AppState.draft-tags;
                placeholder: "comma, separated";
                edited => {
                    AppState.draft-edited();
                }
            }
        }
        HorizontalLayout {
            spacing: Palette.gap;
            Text {
                text: "── fields ──";
                color: fields-fs.has-focus ? Palette.accent : Palette.dim;
                vertical-alignment: center;
            }
            Text {
                text: fields-fs.has-focus ? "↑↓ Tab pick   Enter copy   Esc list" : AppState.fields-hint;
                color: Palette.dim;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
                horizontal-stretch: 1;
            }
            TBtn {
                label: "+ field";
                clicked => {
                    AppState.field-add();
                }
            }
        }
        fields-fs := FocusScope {
            vertical-stretch: 1;
            min-height: 60px;
            // Fixed keys while the fields area has focus (the move / copy actions are remappable).
            KeyBinding {
                keys: @keys(UpArrow);
                activated => {
                    root.step-field(-1);
                }
            }
            KeyBinding {
                keys: @keys(DownArrow);
                activated => {
                    root.step-field(1);
                }
            }
            KeyBinding {
                keys: @keys(Home);
                activated => {
                    root.step-field(-AppState.draft-fields.length);
                }
            }
            KeyBinding {
                keys: @keys(End);
                activated => {
                    root.step-field(AppState.draft-fields.length);
                }
            }
            KeyBinding {
                keys: @keys(Return);
                activated => {
                    AppState.field-copy(AppState.field-cursor);
                }
            }
            KeyBinding {
                keys: @keys(Control + "c");
                activated => {
                    AppState.field-copy(AppState.field-cursor);
                }
            }
            key-pressed(e) => {
                if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
                    return reject;
                }
                if (e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift)) {
                    root.step-field(-1);
                    return accept;
                }
                if (e.text == Key.Tab) {
                    root.step-field(1);
                    return accept;
                }
                reject
            }
            ff := Flickable {
                width: parent.width;
                height: parent.height;
                content-height: AppState.draft-fields.length * root.field-stride;
                for f[i] in AppState.draft-fields: FieldRowView {
                    y: i * root.field-stride;
                    width: parent.width;
                    index: i;
                    f: f;
                    cursor: fields-fs.has-focus && i == AppState.field-cursor;
                }
            }
        }
        HorizontalLayout {
            spacing: Palette.gap * 0.75;
            Text {
                text: "── notes (markdown) ──";
                color: Palette.dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            TBtn {
                label: "edit";
                on: !AppState.notes-preview;
                clicked => {
                    if (AppState.notes-preview) {
                        AppState.toggle-preview();
                    }
                }
            }
            TBtn {
                label: "preview";
                on: AppState.notes-preview;
                clicked => {
                    if (!AppState.notes-preview) {
                        AppState.toggle-preview();
                    }
                }
            }
            TBtn {
                label: "copy";
                clicked => {
                    AppState.copy-notes();
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            min-height: 60px;
            notes-in := NotesInput {
                width: parent.width;
                height: parent.height;
                visible: !AppState.notes-preview;
                text <=> AppState.draft-notes;
                edited => {
                    AppState.draft-edited();
                }
            }
            if AppState.notes-preview: MdView {
                width: parent.width;
                height: parent.height;
            }
        }
        }
    }
}

component Overlay inherits Rectangle {
    // Dim backdrop that swallows clicks.
    background: Palette.bg.with-alpha(0.8);
    TouchArea { }
}

component ConfirmDelete inherits Overlay {
    FocusScope {
        // Overlays sit outside the main key scope, so they carry the shared shortcuts too
        // (Rust decides which actions may run while a dialog is open).
        for b in AppState.bindings: KeyBinding {
            keys: b.keys;
            activated => {
                AppState.run-action(b.action);
            }
        }
        init => {
            self.focus();
        }
        KeyBinding {
            keys: @keys("y");
            activated => {
                AppState.delete-entry();
            }
        }
        KeyBinding {
            keys: @keys("n");
            activated => {
                AppState.cancel-delete();
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                AppState.cancel-delete();
            }
        }
    }

    Panel {
        title: "delete";
        active: true;
        width: Palette.ch * 60;
        height: Palette.row * 6;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        VerticalLayout {
            spacing: Palette.gap * 1.75;
            Text {
                text: "Delete “" + (AppState.draft-label == "" ? "(untitled)" : AppState.draft-label) + "” permanently?";
                color: Palette.fg;
                wrap: word-wrap;
            }
            Text {
                text: "there is no undo and no trash.";
                color: Palette.warn;
            }
            Text {
                text: "Y  delete        N or Esc  keep";
                color: Palette.accent;
            }
        }
    }
}

component TemplatesOverlay inherits Overlay {
    FocusScope {
        // Overlays sit outside the main key scope, so they carry the shared shortcuts too
        // (Rust decides which actions may run while a dialog is open).
        for b in AppState.bindings: KeyBinding {
            keys: b.keys;
            activated => {
                AppState.run-action(b.action);
            }
        }
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                AppState.close-templates();
            }
        }
        KeyBinding {
            keys: @keys(Control + Return);
            activated => {
                AppState.tpl-copy();
            }
        }

        Panel {
            title: "templates";
            active: true;
            width: min(parent.width - 60px, 900px);
            height: min(parent.height - 60px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            HorizontalLayout {
                spacing: Palette.gap * 1.75;
                // template list
                VerticalLayout {
                    width: Palette.ch * 27;
                    spacing: Palette.gap;
                    tl := FocusScope {
                        vertical-stretch: 1;
                        init => {
                            self.focus();
                        }
                        // keep the highlighted template on screen while arrowing
                        property <int> sel: AppState.tpl-selected;
                        changed sel => {
                            if (self.sel >= 0) {
                                if (self.sel * Palette.row < -tpl-list.content-y) {
                                    tpl-list.content-y = -self.sel * Palette.row;
                                } else if ((self.sel + 1) * Palette.row > -tpl-list.content-y + tpl-list.height) {
                                    tpl-list.content-y = -((self.sel + 1) * Palette.row - tpl-list.height);
                                }
                            }
                        }
                        KeyBinding {
                            keys: @keys(UpArrow);
                            activated => {
                                if (AppState.tpl-selected > 0) {
                                    AppState.tpl-select(AppState.tpl-selected - 1);
                                }
                            }
                        }
                        KeyBinding {
                            keys: @keys(DownArrow);
                            activated => {
                                if (AppState.tpl-selected < AppState.templates.length - 1) {
                                    AppState.tpl-select(AppState.tpl-selected + 1);
                                }
                            }
                        }
                        // Scrolls: a template pack adds dozens of rows.
                        tpl-list := Flickable {
                            content-height: AppState.templates.length * Palette.row;
                            for t[i] in AppState.templates: Rectangle {
                                y: i * Palette.row;
                                width: parent.width;
                                height: Palette.row;
                                background: i == AppState.tpl-selected ? Palette.sel-bg : transparent;
                                Text {
                                    x: 6px;
                                    text: (i == AppState.tpl-selected ? "▸ " : "  ") + t.name;
                                    color: i == AppState.tpl-selected ? Palette.accent : Palette.fg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    width: parent.width - 12px;
                                }
                                TouchArea {
                                    clicked => {
                                        AppState.tpl-select(i);
                                        tl.focus();
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Palette.gap * 0.5;
                        TBtn {
                            label: "+ new";
                            clicked => {
                                AppState.tpl-new();
                            }
                        }
                        TBtn {
                            label: "delete";
                            tint: Palette.warn;
                            clicked => {
                                AppState.tpl-delete();
                            }
                        }
                    }
                }
                // editor + fill-in
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Palette.gap;
                    if AppState.tpl-selected < 0: Text {
                        text: "no template — add one with [+ new]";
                        color: Palette.dim;
                    }
                    if AppState.tpl-selected >= 0: VerticalLayout {
                        spacing: Palette.gap;
                        HorizontalLayout {
                            spacing: Palette.gap;
                            Text {
                                text: "name";
                                color: Palette.dim;
                                width: Palette.ch * 8;
                                vertical-alignment: center;
                            }
                            TInput {
                                text <=> AppState.tpl-name;
                                edited => {
                                    AppState.tpl-edited();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Palette.gap;
                            Text {
                                text: "pattern";
                                color: Palette.dim;
                                width: Palette.ch * 8;
                                vertical-alignment: center;
                            }
                            TInput {
                                text <=> AppState.tpl-pattern;
                                placeholder: "ssh {user}@{host} -p {port}";
                                edited => {
                                    AppState.tpl-edited();
                                }
                            }
                        }
                        Text {
                            text: "── fill in (values come from the selected entry) ──";
                            color: Palette.dim;
                        }
                        for v[i] in AppState.tpl-vars: HorizontalLayout {
                            spacing: Palette.gap;
                            Text {
                                text: v.name;
                                color: Palette.accent;
                                width: Palette.ch * 14;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TInput {
                                text: v.value;
                                placeholder: "…";
                                edited => {
                                    AppState.tpl-var-edited(i, self.text);
                                }
                                accepted => {
                                    AppState.tpl-copy();
                                }
                            }
                        }
                        Rectangle { }
                        Text {
                            text: "── result ──";
                            color: Palette.dim;
                        }
                        Text {
                            text: AppState.tpl-preview;
                            color: Palette.fg;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Enter or Ctrl+Enter copy   Tab next field   Esc close";
                            color: Palette.dim;
                        }
                    }
                }
            }
        }
    }
}

// Generic "type to filter, arrows to pick, enter to accept" overlay (Obsidian-style).
component Picker inherits Overlay {
    in property <string> title;
    in property <string> hint;
    in-out property <string> query;
    in property <[PickRow]> rows;
    in-out property <int> selected;
    in property <string> preview;
    in property <string> placeholder;
    callback edited();
    callback select(int);
    callback chosen();
    callback close();

    // Keep the highlighted row on screen while arrowing through a long list.
    changed selected => {
        if (root.selected >= 0) {
            if (root.selected * Palette.row * 2 < -lst.content-y) {
                lst.content-y = -root.selected * Palette.row * 2;
            } else if ((root.selected + 1) * Palette.row * 2 > -lst.content-y + lst.height) {
                lst.content-y = -((root.selected + 1) * Palette.row * 2 - lst.height);
            }
        }
    }

    FocusScope {
        // Overlays sit outside the main key scope, so they carry the shared shortcuts too
        // (Rust decides which actions may run while a dialog is open).
        for b in AppState.bindings: KeyBinding {
            keys: b.keys;
            activated => {
                AppState.run-action(b.action);
            }
        }
        capture-key-pressed(e) => {
            if (e.text == Key.UpArrow) {
                if (root.selected > 0) {
                    root.select(root.selected - 1);
                }
                return accept;
            }
            if (e.text == Key.DownArrow) {
                if (root.selected < root.rows.length - 1) {
                    root.select(root.selected + 1);
                }
                return accept;
            }
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }

        Panel {
            title: root.title;
            active: true;
            width: min(parent.width - 60px, root.preview != "" ? 900px : 560px);
            height: min(parent.height - 60px, 460px);
            x: (parent.width - self.width) / 2;
            y: max(30px, (parent.height - self.height) / 3);
            VerticalLayout {
                spacing: Palette.gap;
                HorizontalLayout {
                    spacing: Palette.gap;
                    Text {
                        text: "▸";
                        color: Palette.accent;
                        vertical-alignment: center;
                    }
                    qi := TInput {
                        placeholder: root.placeholder;
                        text <=> root.query;
                        init => {
                            self.focus-input();
                        }
                        edited => {
                            root.edited();
                        }
                        accepted => {
                            root.chosen();
                        }
                    }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: Palette.gap * 1.75;
                    lst := Flickable {
                        content-height: root.rows.length * Palette.row * 2;
                        for r[i] in root.rows: Rectangle {
                            y: i * Palette.row * 2;
                            height: Palette.row * 2;
                            width: parent.width;
                            background: i == root.selected ? Palette.sel-bg : transparent;
                            VerticalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: (i == root.selected ? "▸ " : "  ") + r.primary;
                                    color: i == root.selected ? Palette.accent : Palette.fg;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    height: Palette.row;
                                }
                                Text {
                                    text: "  " + r.secondary;
                                    color: Palette.dim;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    height: Palette.row;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.select(i);
                                }
                                double-clicked => {
                                    root.select(i);
                                    root.chosen();
                                }
                            }
                        }
                        if root.rows.length == 0: Text {
                            text: "nothing matches";
                            color: Palette.dim;
                        }
                    }
                    if root.preview != "": Rectangle {
                        width: Palette.ch * 52;
                        Text {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: root.preview;
                            color: Palette.fg;
                            wrap: word-wrap;
                            vertical-alignment: top;
                            overflow: elide;
                        }
                    }
                }
                Text {
                    text: root.hint;
                    color: Palette.dim;
                    overflow: elide;
                }
            }
        }
    }
}

